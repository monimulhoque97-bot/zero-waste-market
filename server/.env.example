# ==============================================================================
# ZeroWaste Market - Server Environment Variables
# ==============================================================================

# Server Port & Mode
PORT=5001
NODE_ENV=development

# JWT Authentication
JWT_SECRET=your_jwt_super_secret_key_change_in_production

# MySQL Database Configuration
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=zerowaste_market

# Set to true to force built-in SQLite engine without MySQL server
USE_SQLITE=false

# Google Gemini AI Integration
# Leave empty for Heuristic / Demo Mode fallback
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
